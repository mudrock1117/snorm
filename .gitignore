# 忽略虚拟环境
venv/
__pycache__/
*.pyc
*.pyo

# 仅忽略仓库根目录中的真实数据集。
# 不要使用无前导斜杠的 datasets/，否则会误伤 detection/data/datasets 源码包。
/datasets/

# 忽略模型权重（可以单独备份）
best.pth
trained_models/

# 忽略日志和临时文件
logs/
nohup.out
*.log

# 忽略调试输出
debug/
samples/
runs/

# 忽略渲染结果
adaptive_render_dataset_results/
full_pipeline_results/
integration_results/
render_results_*/
visualization_results/
WZ-Evals/
detection_visualization_plus/

# 忽略测试脚本（可选）
test_*.py

# 忽略IDE配置
.vscode/
.idea/
*.swp
*.swo
*~
# 步骤6消融分析
debug_step6_analysis/step6_src*/feats/*.pkl
debug_step6_analysis/step6_src*/dets/*.pkl
.marscode/

# 临时文件
is -maxdepth*
